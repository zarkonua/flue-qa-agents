# Copy to .env and edit. .env is git-ignored and never leaves this machine.
#
#   cp .env.example .env
#
# Precedence: a variable exported in your shell wins over .env, and .env wins
# over the defaults in code. Every value below is optional except, for OpenRouter,
# OPENROUTER_API_KEY — and a discovery source: TARGET_URL (the application UI),
# QA_API_DOCS_URL (its API documentation), or both.

# --- Target application (Phase 1) -------------------------------------------
# The application UI the browser explores. Not needed for an API-only run, or
# for an automatic run that has API documentation and no UI.
TARGET_URL=http://localhost:4444/

# --- Model ------------------------------------------------------------------
# Canonical Flue form: <provider>/<model>. Default when unset: ollama/qwen3:14b
QA_MODEL=ollama/qwen3:14b
# QA_MODEL=openrouter/deepseek/deepseek-v4-flash-0731

# Required only when QA_MODEL starts with openrouter/. Never committed.
OPENROUTER_API_KEY=

# --- Local Ollama (ignored when QA_MODEL is not ollama/*) --------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Must not exceed the Ollama server's num_ctx, or it silently truncates prompts.
# OLLAMA_CONTEXT_WINDOW=8192
# OLLAMA_MAX_OUTPUT_TOKENS=2048

# --- Workspace --------------------------------------------------------------
# Absolute paths, and they must live OUTSIDE this project.
# Defaults: ../qa-workspace/.qa and ../qa-workspace/target-repo
# QA_ARTIFACT_ROOT=/home/you/projects/qa-workspace/.qa
# QA_TARGET_REPO_ROOT=/home/you/projects/qa-workspace/target-repo

# Origins that are not the product but are part of its test infrastructure —
# a MailHog inbox is the usual case. Without one configured, an account that
# needs email confirmation cannot be confirmed, so discovery stops at sign-up
# and never sees the authenticated product. Host configuration only: the model
# is told what is listed here and may never add to it. Comma-separated.
# QA_DISCOVERY_AUX_ORIGINS=http://localhost:8025

# --- Test coverage ----------------------------------------------------------
# At which level test cases are designed: automatic (default) | ui | api.
# automatic picks UI or API per scenario; api requires QA_API_DOCS_URL.
# QA_COVERAGE_MODE=automatic
# The product's OpenAPI / Swagger documentation: a JSON or YAML document, or a
# Swagger UI page. Read by host code before any agent runs; ignored in ui mode.
# Also the value the New Run form starts with.
# QA_API_DOCS_URL=http://localhost:4444/api/doc

# --- Live API validation ----------------------------------------------------
# With API documentation, the host calls the API and compares real responses with
# it. Read-only by default. "false" uses the documentation alone.
# QA_API_LIVE_VALIDATION=true
# Where the API is, when not where its documentation says (servers[0], else the
# documentation's own origin).
# QA_API_BASE_URL=http://localhost:4444
# Extra hosts the API may be on, besides the documentation's and the target's.
# Nothing else is ever called. Comma-separated host[:port].
# QA_API_ALLOWED_HOSTS=host.docker.internal:4444
# A name for the environment. "production" forbids every state-changing request,
# approved or not.
# QA_API_ENVIRONMENT=test
# State-changing operations approved for a CLI run, as "METHOD /path". Normally
# given per run (--api-approve, or the New Run page) rather than set here.
# QA_API_APPROVED_OPERATIONS=POST /api/notes
# Credentials for secured operations — host configuration only, never shown,
# never stored in an artifact. Use a TEST account. Either a token...
# QA_API_AUTH_TOKEN=
# ...or a user name and password, with the documented sign-in operation that
# turns them into a token (omit the path for HTTP basic authentication).
# QA_API_AUTH_USERNAME=
# QA_API_AUTH_PASSWORD=
# QA_API_AUTH_LOGIN_PATH=/api/auth/signin
# Values for path parameters of read requests (JSON), and limits.
# QA_API_PATH_PARAMS={"id":"42"}
# QA_API_MAX_REQUESTS=60
# QA_API_TIMEOUT_MS=10000

# --- Browser / MCP ----------------------------------------------------------
# PLAYWRIGHT_MCP_URL=http://localhost:8931/mcp
# Playwright MCP working directory — a security boundary. Default: ../qa-workspace/.mcp-output
# QA_MCP_OUTPUT_ROOT=/home/you/projects/qa-workspace/.mcp-output

# --- Review UI (npm run qa:ui) ----------------------------------------------
# QA_UI_PORT=4445
# Extra choices for New Run, besides QA_MODEL / TARGET_URL. Comma-separated.
# QA_UI_MODELS=ollama/gpt-oss-20b-q5-49k,openrouter/deepseek/deepseek-v4-flash-0731
# QA_UI_TARGETS=http://localhost:4444/

# --- Observability (Langfuse) — optional, off by default ---------------------
# Only the exact value "true" enables tracing. When disabled, nothing below is
# read, nothing is initialised and nothing is sent. See docs/observability.md.
LANGFUSE_ENABLED=false
# Required only when LANGFUSE_ENABLED=true. Never committed.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse Cloud (EU) by default; any self-hosted instance works by changing this alone.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# Also send prompts, model responses and tool I/O (redacted; snapshots cut short).
# Off by default: prompts carry whole accessibility snapshots and source files.
LANGFUSE_CAPTURE_IO=false

# --- Orchestration ----------------------------------------------------------
# Attempts per stage before a run stops. Default 4.
# QA_STAGE_ATTEMPTS=4
