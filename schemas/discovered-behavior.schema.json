{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product",
    "locations",
    "areas",
    "behaviors",
    "openQuestions",
    "conflicts"
  ],
  "properties": {
    "product": {
      "type": "string"
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "routes",
          "notes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "area",
          "statement",
          "status",
          "source",
          "confidence",
          "suspectedIssue"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "CONFIRMED",
              "OBSERVED",
              "INFERRED"
            ]
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "suspectedIssue": {
            "type": "boolean"
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "relatedBehaviorIds",
          "impact"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "relatedBehaviorIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impact": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description",
          "sources"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "status"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "status": {
            "enum": [
              "EXPLORED",
              "BLOCKED",
              "SKIPPED_WITH_REASON"
            ]
          },
          "reason": {
            "type": "string"
          },
          "area": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "excludedObservations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
