{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id", "status", "origin", "title", "severity", "priority", "sourceBehaviorIds",
    "preconditions", "steps", "expected", "actual", "expectedBasis", "evidence", "environment", "review"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^BUG-[0-9]{3,}$" },
    "status": { "enum": ["CONFIRMED", "POTENTIAL"] },
    "origin": {
      "type": "object",
      "required": ["phase", "stage", "findingId"],
      "properties": {
        "phase": { "enum": [1, 2] },
        "stage": { "enum": ["defect-analysis", "failure-analysis"] },
        "findingId": { "type": "string" },
        "runId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "title": { "type": "string" },
    "severity": { "enum": ["BLOCKER", "CRITICAL", "MAJOR", "MINOR", "TRIVIAL"] },
    "priority": { "enum": ["UNASSIGNED", "P0", "P1", "P2", "P3"] },
    "area": { "type": "string" },
    "sourceBehaviorIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "sourceAcceptancePointIds": { "type": "array", "items": { "type": "string" } },
    "sourceBusinessRuleIds": { "type": "array", "items": { "type": "string" } },
    "sourceTestCaseIds": { "type": "array", "items": { "type": "string" } },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "expected": { "type": "string" },
    "actual": { "type": "string" },
    "expectedBasis": { "enum": ["CONFIRMED_REQUIREMENT", "EVIDENCED_REQUIREMENT", "INFERRED", "NONE"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "sourceId"],
        "properties": {
          "type": { "enum": ["OBSERVED", "CONFIRMED", "INFERRED", "REQUIREMENT", "TEST_CASE", "TEST_RESULT"] },
          "sourceId": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "required": ["target", "browser"],
      "properties": {
        "target": { "type": "string" },
        "browser": { "type": "string" }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["decision"],
      "properties": {
        "decision": { "enum": ["PENDING", "ACCEPTED", "REJECTED", "CHANGES_REQUESTED"] },
        "by": { "type": "string" },
        "at": { "type": "string" },
        "note": { "type": "string" },
        "downgradedFrom": { "enum": ["CONFIRMED"] },
        "editedFields": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
