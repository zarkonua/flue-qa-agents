{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "feature",
    "acceptancePoints",
    "businessRules",
    "openQuestions",
    "risks"
  ],
  "properties": {
    "feature": {
      "type": "string"
    },
    "acceptancePoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "evidenceIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "testable": {
            "type": "boolean"
          },
          "notTestableReason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "businessRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "evidenceIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "testable": {
            "type": "boolean"
          },
          "notTestableReason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "impact"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "area",
          "probability",
          "impact",
          "rationale"
        ],
        "properties": {
          "area": {
            "type": "string"
          },
          "probability": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "impact": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
