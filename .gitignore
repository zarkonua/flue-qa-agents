node_modules/

# Playwright output — traces, reports, and results are runtime artifacts.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Playwright CLI workspace: per-run snapshots, console logs, and the local
# browser config the CLI writes. `playwright-cli install --skills` regenerates
# the config; the run output is transient.
.playwright-cli/
.playwright/

# Playwright MCP default output directory. The server is now pinned to a cwd
# outside this repo (scripts/mcp-server.mjs), so nothing should land here; this
# line keeps pre-fix residue and any future escape out of the history.
.playwright-mcp/

# Authenticated browser state holds real cookies and tokens. Never commit it,
# and use test accounts only. See the Credentials section of the README.
storage-state*.json
*.storagestate.json
.auth/

# Local secrets.
.env
.env.*
!.env.example

# QA runtime artifacts. The configured root is the sibling ~/projects/qa-workspace/.qa,
# outside this repo; this line guards against a misconfigured QA_ARTIFACT_ROOT.
.qa/

# Claude Code control plane — machine-local or externally installed, not source:
#   settings.local.json          per-machine permissions (Claude Code convention)
#   skills/playwright-cli/       regenerated by `playwright-cli install --skills`
#   skills/mermaid-diagram-skill a separate git clone (would become a broken gitlink)
#   skills/*                     other installed third-party skills
.claude/settings.local.json
.claude/skills/

# Working notes — dated milestone journals, measurements and open decisions.
# Documentation that belongs to the repository lives in docs/ and docs/architecture/.
docs/notes/

# Editor / OS
.idea/
.DS_Store

# Logs
*.log
npm-debug.log*

# Built QA Review Workspace; `npm run qa:ui` rebuilds it when ui/src changes.
ui/dist/
